# Generated build output is committed, and CI regenerates it and fails if the
# result differs. That check runs on Linux and therefore produces LF, so these
# files must stay LF in the working tree too — otherwise a contributor whose
# core.autocrlf rewrites them to CRLF fails the sync check for a reason that
# has nothing to do with their change.
dist/** text eol=lf
src/generated/** text eol=lf
